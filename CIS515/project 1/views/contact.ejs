<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Contact - Martin Medina</title>

    <meta
        name="description"
        content="Contact Martin Medina to share feedback about the Job Application Tracker project.">

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        crossorigin="anonymous">

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap"
        rel="stylesheet">

    <!-- Express Public CSS -->
    <link
        rel="stylesheet"
        href="/styles/styles.css">

</head>

<body>

<div class="banner">

    <div class="banner-image">

        <img
            src="/images/banner.jpg"
            alt="Job Application Tracker project banner">

    </div>

</div>

<div class="container-fluid container-md px-3 px-md-4">

    <!-- Navigation -->

    <nav class="navbar navbar-expand-lg navbar-dark site-navbar rounded-bottom mb-4">

        <div class="container-fluid">

            <a class="navbar-brand" href="/">
                Martin Medina
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavigation"
                aria-controls="mainNavigation"
                aria-expanded="false"
                aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">

                        <a class="nav-link" href="/">
                            Home
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link" href="/project">
                            Page 1: Project
                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link" href="/mobile">
                            Page 2: Mobile
                        </a>

                    </li>

                    <li class="nav-item">

                        <a
                            class="nav-link active"
                            aria-current="page"
                            href="/contact">

                            Contact

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <main class="content-panel">

        <h1>Contact Martin Medina</h1>

        <section>

            <h2>Project Feedback</h2>

            <p class="bio">

                Have a question or suggestion about the
                Job Application Tracker project?

                Use the form below to share your feedback.

            </p>

            <form
                id="contactForm"
                action="/contact"
                method="POST"
                class="needs-validation"
                novalidate>

                <div class="mb-3">

                    <label
                        for="name"
                        class="form-label">

                        Name

                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        autocomplete="name"
                        minlength="2"
                        required>

                    <div class="invalid-feedback">

                        Please enter your name
                        (at least 2 characters).

                    </div>

                </div>

                <div class="mb-3">

                    <label
                        for="email"
                        class="form-label">

                        Email Address

                    </label>

                    <input
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        autocomplete="email"
                        required>

                    <div class="invalid-feedback">

                        Please enter a valid
                        email address.

                    </div>

                </div>

                <div class="mb-3">

                    <label
                        for="subject"
                        class="form-label">

                        Subject

                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="subject"
                        name="subject"
                        required>

                    <div class="invalid-feedback">

                        Please enter a subject.

                    </div>

                </div>

                <div class="mb-3">

                    <label
                        for="message"
                        class="form-label">

                        Message

                    </label>

                    <textarea
                        class="form-control"
                        id="message"
                        name="message"
                        rows="6"
                        minlength="10"
                        required></textarea>

                    <div class="invalid-feedback">

                        Please enter a message
                        with at least 10 characters.

                    </div>

                </div>

                <div class="d-grid d-sm-flex gap-3">

                    <button
                        type="submit"
                        class="btn btn-primary project-button">

                        Submit Feedback

                    </button>

                    <button
                        type="reset"
                        class="btn btn-outline-info">

                        Clear Form

                    </button>

                </div>

            </form>

        </section>

    </main>

    <footer id="site-footer">

        <p>
            &copy; 2026 Martin Medina |
            CIS-515 |
            All Rights Reserved
        </p>

    </footer>

</div>

<!-- Bootstrap JS -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    crossorigin="anonymous">
</script>

<!-- Custom JS -->

<script src="/js/script.js"></script>

</body>

</html>